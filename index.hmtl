<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kalender</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <select name="" id="monthselection"></select>
    <select name="" id="yearselection"></select>
    <h2 id="month-year"></h2>
    <div id="selectedMonthDaysContainer"></div>
    <div id="selectedDayContainer">
        <h2 id="day"></h2>
        <h3>
            <span>Geburtstage</span>
            <span id="birthdayCount">0</span>
        </h3>

        <div id="selectedDayBirthdays"></div>
        <h3>
            <span>Aufgaben</span>
            <span id="taskCount">0</span>
        </h3>
        <div id="selectedDayTasks"></div>
        <h3>
            <span>Termine</span>
            <span id="appointmentCount">0</span>
        </h3>
        <div id="selectedDayAppointments"></div>
        <h3>
            <span>Aktivitäten</span>
            <span id="activityCount">0</span>
        </h3>
        <div id="selectedDayActivities"></div>
        <div>
            <input id="name" type="text">
            <select name="" id="">
                <option onclick="selectAddType('Geburtstag')" value="">Geburtstag</option>
                <option onclick="selectAddType('Aufgabe')" value="">Aufgabe</option>
                <option onclick="selectAddType('Termin')" value="">Termin</option>
                <option onclick="selectAddType('Aktivität')" value="">Aktivität</option>
            </select>
            <button onclick="add()">Hinzufügen</button>
        </div>
    </div>
    <script src="script.js"></script>
</body>
</html>
